{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RotoBrush",
  "version": "0.1.0",
  "identifier": "app.rotobrush.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "RotoBrush", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700, "dragDropEnabled": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../backend/dist/rotobrush-backend": "backend" }
  }
}
